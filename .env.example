# Application
PITCHBOT_APP_ENV=local
PITCHBOT_LOG_LEVEL=INFO
PITCHBOT_DATABASE_URL=sqlite:///./data/pitchbot.db

# External side effects (default OFF)
PITCHBOT_ENABLE_TELEPHONY=false
PITCHBOT_ENABLE_WHATSAPP=false
PITCHBOT_ENABLE_EXTERNAL_NETWORK=false
PITCHBOT_ENABLE_REAL_TIME_AUDIO=false
PITCHBOT_ENABLE_HOSTED_DEMO=false
PITCHBOT_ENABLE_DURABLE_HISTORY=false
PITCHBOT_DURABLE_HISTORY_DIGEST_KEY=

# Allowlist and compliance
PITCHBOT_ALLOWLIST_ENABLED=true
PITCHBOT_ALLOWED_CONTACTS=
PITCHBOT_REQUIRE_AI_DISCLOSURE=true
PITCHBOT_REQUIRE_DND_CHECK=true
PITCHBOT_REQUIRE_CALLING_HOURS=true

# Runtime
PITCHBOT_TIMEZONE=Asia/Kolkata
PITCHBOT_MAX_CALL_MINUTES=12
PITCHBOT_MAX_TURNS=80
