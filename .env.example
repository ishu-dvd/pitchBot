# Application
PITCHBOT_APP_ENV=local
PITCHBOT_LOG_LEVEL=INFO
PITCHBOT_DATABASE_URL=sqlite:///./data/pitchbot.db

# External side effects (default OFF)
PITCHBOT_ENABLE_TELEPHONY=false
PITCHBOT_ENABLE_WHATSAPP=false
PITCHBOT_ENABLE_EXTERNAL_NETWORK=false
PITCHBOT_ENABLE_REAL_TIME_AUDIO=false
PITCHBOT_ENABLE_HOSTED_DEMO=false
PITCHBOT_ENABLE_DURABLE_HISTORY=false
PITCHBOT_DURABLE_HISTORY_DIGEST_KEY=

# Contact allowlist data (compliance gates below are always enforced in code)
PITCHBOT_ALLOWED_CONTACTS=

# Runtime
PITCHBOT_TIMEZONE=Asia/Kolkata
PITCHBOT_MAX_CALL_MINUTES=12
PITCHBOT_MAX_TURNS=80

# Non-authoritative lead recall budgets (durable history only).
PITCHBOT_LEAD_RECALL_TOP_K=3
PITCHBOT_LEAD_RECALL_DEADLINE_MS=150
PITCHBOT_LEAD_RECALL_FAILURE_BUDGET=3

# Speech providers (default: mock detector, NO transcriber, NO synthesiser).
#
# No provider has satisfied ADR-0004, so none is a default. Left as-is the simulator
# behaves exactly as it did before the real adapters existed: endpointing and barge-in
# work, and every spoken utterance is reported as `transcriber-unavailable` rather than
# invented.
#
# Naming a provider whose optional extra is NOT installed is a startup error, not a
# silent downgrade -- otherwise you would believe speech works while every utterance is
# being dropped.
#
#   pip install -e ".[webrtc-vad]"      # for PITCHBOT_SPEECH_VAD_PROVIDER=webrtc
#   pip install -e ".[faster-whisper]"  # for PITCHBOT_SPEECH_STT_PROVIDER=faster-whisper
PITCHBOT_SPEECH_VAD_PROVIDER=mock
PITCHBOT_SPEECH_VAD_MODE=2
PITCHBOT_SPEECH_VAD_SAMPLE_RATE_HZ=16000

PITCHBOT_SPEECH_STT_PROVIDER=none
# `small` is the floor for bilingual use: `tiny` and `base` emit the wrong SCRIPT for
# Hindi (romanised Latin and Urdu respectively), which no tuning fixes.
PITCHBOT_SPEECH_STT_MODEL=small
PITCHBOT_SPEECH_STT_DEVICE=cpu
PITCHBOT_SPEECH_STT_COMPUTE_TYPE=int8
PITCHBOT_SPEECH_STT_BEAM_SIZE=1
# Empty means auto-detect. Whisper labels anything -- including silence -- so the adapter
# reports `unknown` below its detection-probability floor rather than guessing.
PITCHBOT_SPEECH_STT_LANGUAGE=
# Model weights are never fetched unless this is explicitly enabled.
PITCHBOT_SPEECH_STT_DOWNLOAD_ROOT=
PITCHBOT_SPEECH_STT_ALLOW_DOWNLOAD=false

# Text-to-speech: who speaks the agent's reply.
#
# `none` leaves it to the browser's Web Speech API, which is what shipped before. That is
# a working fallback, but its voices vary by browser and OS, Hindi is frequently absent,
# and on several platforms synthesis is performed by a REMOTE service -- so a local-first
# deployment that promises `audio_retained: false` should not rely on it.
#
#   pip install -e ".[piper-tts]"   # for PITCHBOT_SPEECH_TTS_PROVIDER=piper
#
# Voices are operator-supplied `<voice-id>.onnx` + `.onnx.json` pairs placed in the voice
# directory; PitchBot never downloads them. There is no fallback voice: an unmapped
# language is an error, because serving Hindi through an English voice produces confident
# audio in the wrong language rather than a failure.
PITCHBOT_SPEECH_TTS_PROVIDER=none
PITCHBOT_SPEECH_TTS_VOICE_DIR=
PITCHBOT_SPEECH_TTS_VOICES=
# Every reviewed Piper Hindi voice is non-commercial or has an unresolvable license, so a
# bilingual local evaluation needs this. PitchBot is a sales assistant: leaving it on in a
# deployment would be a licensing breach. See docs/BENCHMARKS.md.
PITCHBOT_SPEECH_TTS_ALLOW_NON_COMMERCIAL=false
# Identical text yields byte-identical audio. Useful for tests and generated corpora; it
# costs the natural duration variation that makes speech sound unrehearsed.
PITCHBOT_SPEECH_TTS_DETERMINISTIC=false
