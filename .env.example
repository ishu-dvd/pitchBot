# Application
PITCHBOT_APP_ENV=local
PITCHBOT_LOG_LEVEL=INFO
PITCHBOT_DATABASE_URL=sqlite:///./data/pitchbot.db

# External side effects (default OFF)
PITCHBOT_ENABLE_TELEPHONY=false
PITCHBOT_ENABLE_WHATSAPP=false
PITCHBOT_ENABLE_EXTERNAL_NETWORK=false
# Gates the simulator's audio WebSocket, which accepts a live microphone stream.
# The browser demo needs this set to true; `pitchbot-talk` captures directly and does not.
PITCHBOT_ENABLE_REAL_TIME_AUDIO=false
PITCHBOT_ENABLE_HOSTED_DEMO=false
PITCHBOT_ENABLE_DURABLE_HISTORY=false
PITCHBOT_DURABLE_HISTORY_DIGEST_KEY=

# Contact allowlist data (compliance gates below are always enforced in code)
PITCHBOT_ALLOWED_CONTACTS=

# Runtime
PITCHBOT_TIMEZONE=Asia/Kolkata
PITCHBOT_MAX_CALL_MINUTES=12
PITCHBOT_MAX_TURNS=80

# Non-authoritative lead recall budgets (durable history only).
PITCHBOT_LEAD_RECALL_TOP_K=3
PITCHBOT_LEAD_RECALL_DEADLINE_MS=150
PITCHBOT_LEAD_RECALL_FAILURE_BUDGET=3

# Speech providers (default: mock detector, NO transcriber, NO synthesiser).
#
# No provider has satisfied ADR-0004, so none is a default. Left as-is the simulator
# behaves exactly as it did before the real adapters existed: endpointing and barge-in
# work, and every spoken utterance is reported as `transcriber-unavailable` rather than
# invented.
#
# Naming a provider whose optional extra is NOT installed is a startup error, not a
# silent downgrade -- otherwise you would believe speech works while every utterance is
# being dropped.
#
#   pip install -e ".[webrtc-vad]"      # for PITCHBOT_SPEECH_VAD_PROVIDER=webrtc
#   pip install -e ".[faster-whisper]"  # for PITCHBOT_SPEECH_STT_PROVIDER=faster-whisper
PITCHBOT_SPEECH_VAD_PROVIDER=mock
PITCHBOT_SPEECH_VAD_MODE=2
PITCHBOT_SPEECH_VAD_SAMPLE_RATE_HZ=16000

PITCHBOT_SPEECH_STT_PROVIDER=none
# `small` is the floor for bilingual use: `tiny` and `base` emit the wrong SCRIPT for
# Hindi (romanised Latin and Urdu respectively), which no tuning fixes.
PITCHBOT_SPEECH_STT_MODEL=small
PITCHBOT_SPEECH_STT_DEVICE=cpu
PITCHBOT_SPEECH_STT_COMPUTE_TYPE=int8
PITCHBOT_SPEECH_STT_BEAM_SIZE=1
# Empty means auto-detect. Whisper labels anything -- including silence -- so the adapter
# reports `unknown` below its detection-probability floor rather than guessing.
PITCHBOT_SPEECH_STT_LANGUAGE=
# Model weights are never fetched unless this is explicitly enabled.
PITCHBOT_SPEECH_STT_DOWNLOAD_ROOT=
PITCHBOT_SPEECH_STT_ALLOW_DOWNLOAD=false

# Text-to-speech: who speaks the agent's reply.
#
# `none` leaves it to the browser's Web Speech API, which is what shipped before. That is
# a working fallback, but its voices vary by browser and OS, Hindi is frequently absent,
# and on several platforms synthesis is performed by a REMOTE service -- so a local-first
# deployment that promises `audio_retained: false` should not rely on it.
#
#   pip install -e ".[piper-tts]"   # for PITCHBOT_SPEECH_TTS_PROVIDER=piper
#
# Voices are operator-supplied `<voice-id>.onnx` + `.onnx.json` pairs placed in the voice
# directory; PitchBot never downloads them. There is no fallback voice: an unmapped
# language is an error, because serving Hindi through an English voice produces confident
# audio in the wrong language rather than a failure.
PITCHBOT_SPEECH_TTS_PROVIDER=none
PITCHBOT_SPEECH_TTS_VOICE_DIR=
PITCHBOT_SPEECH_TTS_VOICES=
# Every reviewed Piper Hindi voice is non-commercial or has an unresolvable license, so a
# bilingual local evaluation needs this. PitchBot is a sales assistant: leaving it on in a
# deployment would be a licensing breach. See docs/BENCHMARKS.md.
PITCHBOT_SPEECH_TTS_ALLOW_NON_COMMERCIAL=false
# Identical text yields byte-identical audio. Useful for tests and generated corpora; it
# costs the natural duration variation that makes speech sound unrehearsed.
PITCHBOT_SPEECH_TTS_DETERMINISTIC=false
# Say "hmm" while the transcriber works instead of going silent. Measured, a spoken turn
# takes ~2.6 s end to end - about 13x the ~200 ms gap between human turns - and two thirds
# of it is transcription, so nothing can be said about the buyer's words until almost all
# of it has elapsed. Costs nothing when no voice is configured: with no synthesiser there
# is no audio path to fill and the filler stays inert. See docs/SIMULATOR.md.
PITCHBOT_SPEECH_BACKCHANNEL_ENABLED=true

# Local language model (default: none).
#
# The reply planner reads the slots the conversation has filled and asks for the most
# useful missing one, with NO model at all. A model only improves *understanding* of what
# the buyer said -- it never changes how a reply is composed, and cannot introduce a
# question nobody wrote.
#
#   pip install -e ".[local-llm]"   # for PITCHBOT_LLM_PROVIDER=onnx-genai
#
# Cost, measured on an 8-core CPU with no accelerator: ~1 ms per turn without a model,
# ~5.2 s per turn with Phi-3.5-mini. That is too slow for the spoken path, which is why
# this is off by default. See docs/BENCHMARKS.md.
PITCHBOT_LLM_PROVIDER=none
# An ONNX Runtime GenAI model directory (must contain genai_config.json). Operator-supplied;
# PitchBot never downloads weights.
PITCHBOT_LLM_MODEL_DIR=
# The UPSTREAM model id, e.g. Qwen/Qwen2.5-0.5B-Instruct -- NOT the conversion repository
# the files came from. A quantised re-upload does not relicense the weights, and this is
# what the licence gate reads.
PITCHBOT_LLM_MODEL_ID=
# Qwen2.5-3B is "FOR NON-COMMERCIAL PURPOSES ONLY" while its 0.5B and 1.5B siblings are
# Apache-2.0. PitchBot is a sales assistant: leaving this on in a deployment would be a
# licensing breach.
PITCHBOT_LLM_ALLOW_NON_COMMERCIAL=false

# --- API access control ---------------------------------------------------------------
# Comma-separated "<name>:<secret>" pairs. Secrets must be at least 16 characters: a short
# key is not weak authentication, it is the appearance of authentication.
#
# Empty is accepted ONLY when PITCHBOT_APP_ENV=local. Anywhere else the application
# refuses to start, because every endpoint -- including the audio socket -- is otherwise
# open to anyone who can reach the port.
PITCHBOT_API_KEYS=
# A single turn costs seconds of CPU, so the limit that matters is small and per-credential.
# Burst covers a client opening a session and immediately taking a turn; the sustained rate
# is what stops a loop. Enforced per process, so N workers means N times this budget.
PITCHBOT_API_RATE_LIMIT_BURST=20
PITCHBOT_API_RATE_LIMIT_PER_SECOND=2.0

# --- Early language detection ----------------------------------------------------------
# Identify the language while the buyer is still talking, so transcription does not have to.
# The auto-detect default makes Whisper encode the audio twice: measured 3,857 ms against
# 2,235 ms when the language is already known. Detection cost is flat regardless of how much
# audio it gets (Whisper pads to 30 s), so the only way to win is to start it sooner.
#
# End to end this took English from 3,983 ms to 2,407 ms with an identical transcript.
# Set to 0 for exactly the behaviour that shipped before this existed.
#
# 2.0 is the shortest measured-SAFE prefix, not merely the shortest useful one: at 1.5 s
# Telugu was identified as Malayalam at probability 0.90.
PITCHBOT_SPEECH_STT_EARLY_DETECTION_SECONDS=2.0
# Stricter than the reporting floor, because this decides whether to IMPOSE a language on the
# decoder. Forcing a wrong one does not produce a broken transcript, it produces a fluent
# translation -- Hindi audio decoded as `en` came back as confident English at 0.616, while
# the correct Telugu transcript scored 0.316 -- so no confidence signal separates the two.
PITCHBOT_SPEECH_STT_EARLY_DETECTION_MIN_PROBABILITY=0.7

# --- Observability ---------------------------------------------------------------------
# JSON lines carrying session and turn correlation ids, with buyer content redacted by the
# formatter rather than by convention. Set false for human-readable lines while developing --
# but note that a format which differs between a laptop and production is a format whose
# redaction nobody has watched work.
PITCHBOT_LOG_JSON=true

# --- Unsupported speech languages --------------------------------------------------------
# Languages the transcriber declines rather than transcribing badly. Telugu is the measured
# case: Whisper `small` returns nonsense in every decoder configuration tried and takes
# 37,533 ms to do it, five and a half times real time.
#
# Only applied when early detection identified the language CONFIDENTLY, so an uncertain
# guess still transcribes. Telugu TEXT turns are unaffected -- this is about speech only.
# Set empty to restore the previous behaviour.
PITCHBOT_SPEECH_STT_UNSUPPORTED_LANGUAGES=te

# Wall-clock ceiling on transcribing one utterance, in milliseconds. 0 waits forever.
#
# Measured 2026-09-06: a 3.2 s HINDI clip - a supported language, shipped settings - took a
# median of 11,455 ms and was seen at 28,656 ms, while every healthy transcription costs
# 1.9-2.5 s regardless of audio length. The socket's receive loop waits inside the pipeline,
# so an unbounded transcription does not merely delay the reply: the agent is deaf and cannot
# be interrupted for the whole time. Raise it if you submit more than 20 s of audio per
# utterance - four 30 s windows cost roughly four times one. See docs/BENCHMARKS.md.
PITCHBOT_SPEECH_STT_TIMEOUT_MS=6000

# Hindi speech. Empty (the default) means Piper serves every language, as before -- and
# that a commercial deployment cannot say a Hindi word aloud, because every published Piper
# Hindi voice reviewed is CC-BY-NC-SA or has an unresolvable licence.
#
# Measured 2026-09-06: Supertonic 3 at 8 steps scores 13.2% CER on Hindi against 18.3% for
# the Piper voice this project may not ship -- better, and legal. It costs ~1,130 ms per
# sentence against Piper's 126-448 ms, and it has NO Telugu, which is why it is a route for
# some languages rather than a replacement.
#
# Its weights are OpenRAIL-M: commercial use is permitted, but Attachment A clause (e)
# requires that generated content be expressly and intelligibly disclaimed as machine
# generated. Setting this is accepting that obligation for your deployment.
#
#   pip install -e ".[supertonic-tts]"
PITCHBOT_SPEECH_TTS_SUPERTONIC_LANGUAGES=
PITCHBOT_SPEECH_TTS_SUPERTONIC_VOICE=F1
PITCHBOT_SPEECH_TTS_SUPERTONIC_MODEL_DIR=
# 4 halves the latency and costs 8.7 points of CER; 16 costs 1.8x the latency for nothing.
PITCHBOT_SPEECH_TTS_SUPERTONIC_STEPS=8
PITCHBOT_SPEECH_TTS_SUPERTONIC_ALLOW_DOWNLOAD=false
